[0.910, "o", "\u001b[38;5;110m● Bash\u001b[0m   date '+%Y-%m-%d %A %z %Z' · gh api user --jq .login\r\n\u001b[2m  ⎿ 2026-08-11 Tuesday -0700 PDT · dbaggott\u001b[0m\r\n"]
